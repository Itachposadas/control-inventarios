# Saltos de línea: LF en el repositorio y en la copia de trabajo, en cualquier
# sistema operativo. Evita los avisos "LF will be replaced by CRLF" en Windows.
* text=auto eol=lf

# Scripts de Windows: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca se convierten
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.docx binary
*.woff binary
*.woff2 binary
